[Unit]
Description=Personal Edge Lab read-only API and dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/personal-edge-lab
EnvironmentFile=/home/ubuntu/personal-edge-lab/.env
ExecStart=/home/ubuntu/personal-edge-lab/.venv/bin/python -m personal_edge_lab.apps.api
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
